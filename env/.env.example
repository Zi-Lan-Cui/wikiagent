# Copy this file to env/.env and fill in the model credentials.
# Runtime settings should be changed here, not in RootConfig.

LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=your-chat-model
# enabled/disabled；enabled 走服务端默认，disabled 显式关思考
LLM_THINKING=enabled
# 单次请求超时（秒）；思考模型两次数据块间隔易超 120s，故默认 300
LLM_TIMEOUT=300
# RPM/TPM 设为 0 可关闭对应窗口限制；并发数必须至少为 1。
LLM_MAX_CONCURRENCY=4
# 每分钟请求数上限
LLM_REQUESTS_PER_MINUTE=60
# 每分钟 token 数上限
LLM_TOKENS_PER_MINUTE=500000

# 视觉模型，仅用于图片 caption；三项留空则跳过图片，纯文本编译不受影响
VLM_API_KEY=your-vlm-api-key
# 视觉模型端点，规则同 LLM_BASE_URL
VLM_BASE_URL=https://api.openai.com/v1
# 视觉模型名
VLM_MODEL_ID=your-vision-model
# 限流口径同 LLM_*；视觉模型通常限得更紧，按供应商文档下调
VLM_MAX_CONCURRENCY=4
# 每分钟请求数上限
VLM_REQUESTS_PER_MINUTE=60
# 每分钟 token 数上限
VLM_TOKENS_PER_MINUTE=500000

# Paths are relative to the project root unless absolute paths are required.
# 原始资料根目录，可以指定为你的笔记存放位置
WIKI_INPUTS_DIR=inputs
# wiki 页面输出目录
WIKI_WIKI_DIR=wiki
# 运行状态目录：sessions / memory_store / staging / tmp / logs
WIKI_WORKSPACE_DIR=workspace

# Agent / QA runtime
# 模型最大上下文窗口
AGENT_CONTEXT_WINDOWS=128000
# 最大生成量
AGENT_MAX_TOKENS=4096
# 历史窗口的最大消息数，窗口起点必须落在 user 消息上
AGENT_MAX_MESSAGES_LENGTH=2000
# 单次回答最多几轮「调模型→跑工具」，超出即强制收尾
AGENT_MAX_LOOP=20
# 上下文压缩触发阈值 
AGENT_TRIGGER_RATIO=0.8
# 压缩后最大保留比例
AGENT_CONSOLIDATE_RATIO=0.5
# 会话空闲多久视为结束（分钟）
AGENT_SESSION_IDLE_MINUTES=15
# 空闲收尾时保留不压缩的尾部消息条数
AGENT_SESSION_TAIL_MESSAGES=6
# Dream 后台任务的轮询间隔（秒）
# Dream 用于长期记忆的整理
AGENT_DREAM_POLL_INTERVAL=60
# 工具结果的保留时长（分钟），过期由模型重新读取
AGENT_TOOL_RESULT_TTL_MINUTES=30
# 工具结果超此字符数转存到 workspace/tmp，上下文只留摘要
AGENT_TOOL_PERSIST_LENGTH=8000
# token 估算安全余量，可用预算 = 窗口 − 输出 − 该值
AGENT_SNIP_SAFE_BUFFER=1024
# 紧凑化目标占用比，超限时压到可用预算的这个比例
AGENT_INFLIGHT_TARGET_RATIO=0.85
# 短于此字符数的工具结果不做紧凑化
AGENT_INFLIGHT_COMPACT_MIN_CHARS=500
# 超限截断后保留的预算比例
AGENT_SNIP_RATIO=0.5
# system prompt 中 wiki 索引地图的截断字符数
# 需要根据笔记规模合理设计，估算一篇笔记在索引上的数目
# 为 50 字，INDEX 16000 能承载 320 条索引，合理设置避免索引被截断
AGENT_WIKI_INDEX_CHARS=16000
# system prompt 中纠错清单的截断字符数
AGENT_CORRECTIONS_CHARS=2000

# Compiler budgets and throughput
# 编译链路的上下文窗口，与 AGENT_CONTEXT_WINDOWS 互相独立
COMPILE_CONTEXT_WINDOW=128000
# 单个分块的最大字符数；调大减少调用次数，也更容易顶满预算
COMPILE_CHUNK_SIZE=8000
# 同一文件内分块摘要的并发度
COMPILE_EXTRACT_CONCURRENCY=3
# 每个分块为 system prompt 预留的 token
COMPILE_EXTRACT_SYSTEM_TOKENS=4000
# 每个分块为模型输出预留的 token
COMPILE_EXTRACT_OUTPUT_TOKENS=6000
# 额外安全缓冲，与上面两项一起从窗口扣减
COMPILE_CONTEXT_SAFETY_BUFFER=1024
# auto=builtin优先、mineru兜底版面格式；
# builtin=不使用mineru；使用mineru需额外安装
COMPILE_PARSE_BACKEND=auto  

# Retry policy
# 总尝试次数（含首次），异常重试与响应拒绝共用该预算
RETRY_LLM_MAX_ATTEMPTS=3
# 指数退避基数（秒）
RETRY_LLM_BASE_DELAY_SECONDS=2

# eval 评判模型
# 三项留空则回退用 LLM_*；同族模型判分一致率偏高，正式校准建议换族
# JUDGE_API_KEY=your-judge-api-key
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_MODEL_ID=your-judge-model

# true 时输出全量日志并写 workspace/debug.log
LOG_DEBUG=false
